# Copiá este archivo a .env y completá los valores.

# Supabase → Project Settings → Database → Connection string
# Pooler (puerto 6543, modo transaction) para la app:
DATABASE_URL="postgresql://postgres.TU-PROYECTO:CONTRASENA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Conexión directa (puerto 5432) para migraciones:
DIRECT_URL="postgresql://postgres.TU-PROYECTO:CONTRASENA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# NextAuth: generá el secreto con `npx auth secret` o `openssl rand -base64 32`
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""

# Supabase Realtime + Storage (opcional, las cuatro o ninguna). Sin ellas, el chat funciona por
# consultas periódicas (sin "escribiendo…" ni "en línea") y la carga de fotos queda deshabilitada.
# Project Settings → API: URL, anon key y service_role key.
# Project Settings → JWT Keys → "Legacy JWT secret" (firma los tokens de Realtime de cada usuario).
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_JWT_SECRET=""

# Mantenimiento diario (vence solicitudes, avisa fletes demorados, borra fotos abandonadas).
# Vercel Cron lo manda en el header Authorization. Generalo con: openssl rand -hex 32
CRON_SECRET=""

# Emails (recuperar contraseña) con Resend: https://resend.com → API Keys. Opcional.
# Sin clave, en desarrollo el link se muestra en la consola del servidor; en producción no se envía.
# El remitente necesita un dominio verificado en Resend; sin él, Resend solo entrega a la cuenta dueña.
RESEND_API_KEY=""
CORREO_REMITENTE="Fletes Tucumán <no-responder@tu-dominio.com>"
