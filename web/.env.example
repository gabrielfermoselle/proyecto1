# Copiá este archivo a .env y completá los valores.

# Supabase → Project Settings → Database → Connection string
# Pooler (puerto 6543, modo transaction) para la app desplegada (Vercel, en la misma región que la base).
# En desarrollo local, si la base está lejos (p. ej. us-east-1 desde Argentina), usá el Session pooler
# (puerto 5432, sin pgbouncer=true, con connection_limit=5): cada consulta tarda ~5 veces menos.
DATABASE_URL="postgresql://postgres.TU-PROYECTO:CONTRASENA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Conexión directa (puerto 5432) para migraciones:
DIRECT_URL="postgresql://postgres.TU-PROYECTO:CONTRASENA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# NextAuth: generá el secreto con `npx auth secret` o `openssl rand -base64 32`
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""

# Supabase. SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY alcanzan para los datos y para las fotos
# (el servidor sube a Storage con la service_role). La anon key y el "Legacy JWT secret" son solo
# para Realtime en vivo: sin ellos el chat anda igual, pero por consultas periódicas (sin
# "escribiendo…" ni "en línea"). Project Settings → API: URL, anon key y service_role key.
# Project Settings → JWT Keys → "Legacy JWT secret".
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_ANON_KEY=""
SUPABASE_JWT_SECRET=""

# Mantenimiento diario (vence solicitudes, avisa fletes demorados, borra fotos abandonadas).
# Vercel Cron lo manda en el header Authorization. Generalo con: openssl rand -hex 32
CRON_SECRET=""

# Emails (recuperar contraseña) con Resend: https://resend.com → API Keys. Opcional.
# Sin clave, en desarrollo el link se muestra en la consola del servidor; en producción no se envía.
# El remitente necesita un dominio verificado en Resend; sin él, Resend solo entrega a la cuenta dueña.
RESEND_API_KEY=""
CORREO_REMITENTE="Fletes Tucumán <no-responder@tu-dominio.com>"
